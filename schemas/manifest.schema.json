{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-replicant.local/schemas/manifest/v1",
  "title": "Claude Replicant Capsule Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "packageType",
    "createdAt",
    "source",
    "runtime",
    "git",
    "entries",
    "reports",
    "readiness",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageType": { "const": "forensic-backup" },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
