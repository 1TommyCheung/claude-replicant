{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-replicant.local/schemas/manifest/v1",
  "title": "Claude Replicant Capsule Manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "packageId",
    "packageType",
    "createdAt",
    "source",
    "runtime",
    "git",
    "entries",
    "agentState",
    "reports",
    "readiness",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "packageType": { "const": "forensic-backup" },
    "source": {
      "type": "object",
      "properties": {
        "kind": { "enum": ["git-repository", "folder"] }
      },
      "additionalProperties": true
    },
    "git": {
      "type": "object",
      "properties": {
        "applicable": { "type": "boolean" },
        "reconstruction": { "enum": ["byte-for-byte-dot-git-and-index", "not-applicable"] }
      },
      "additionalProperties": true
    },
    "agentState": {
      "type": "object",
      "required": ["adapter", "rootAlias", "projectKey", "sessionIds", "sessionCatalog", "entries", "reconstruction"],
      "properties": {
        "sessionCatalog": {
          "type": "object",
          "required": ["report", "total", "directlyResumable"],
          "properties": {
            "report": { "const": "sessions.json" },
            "total": { "type": "integer", "minimum": 0 },
            "directlyResumable": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      }
    },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
