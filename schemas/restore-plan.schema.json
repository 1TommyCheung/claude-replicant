{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-replicant.local/schemas/restore-plan/v1",
  "title": "Claude Replicant Restore Plan",
  "type": "object",
  "required": [
    "schema",
    "planId",
    "createdAt",
    "capsulePath",
    "capsuleId",
    "manifestDigest",
    "destination",
    "claudeDestination",
    "activation",
    "validation",
    "executable",
    "blockers",
    "operations",
    "agentOperations",
    "declaredVariances",
    "planDigest"
  ],
  "properties": {
    "schema": { "const": "claude-replicant.restore-plan/v1" },
    "planId": { "type": "string" },
    "createdAt": { "type": "string" },
    "capsulePath": { "const": "$CAPSULE_ROOT" },
    "capsuleId": { "type": "string" },
    "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "destination": { "type": "string" },
    "claudeDestination": { "type": "string" },
    "activation": { "type": "string" },
    "validation": { "type": "object" },
    "executable": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "object" } },
    "operations": { "type": "array", "items": { "type": "object" } },
    "agentOperations": { "type": "array", "items": { "type": "object" } },
    "declaredVariances": { "type": "array", "items": { "type": "object" } },
    "planDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": true
}
